{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "wajeeha.dev", "custom_domain": true },
    { "pattern": "www.wajeeha.dev", "custom_domain": true }
  ]
}
